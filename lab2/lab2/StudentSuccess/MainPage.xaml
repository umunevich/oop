<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentSuccess.MainPage"
            Shell.NavBarIsVisible="False"
            BackgroundColor="BurlyWood">

    <Grid
    Padding="5"
    ColumnSpacing="5"
    RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="19"/>
            <RowDefinition Height="0.9*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <HorizontalStackLayout
        Grid.Row="0"
        Grid.Column="0"
        Spacing="5">
            <Button
            x:Name="ChooseFileButton"
            Text="Вибрати файл"
            Clicked="ChooseFileButton_Clicked"/>
            <Button
            x:Name="SaveButton"
            Text="Зберегти"
            Clicked="SaveButton_Clicked"/>
            <Button
            x:Name="TransformToHtmlButton"
            Text="Трансформувати як HTML"
            Clicked="TransformToHtmlButton_Clicked"/>
            <Picker
                    x:Name="StrategyPicker"
                    TextColor="Black"
                    BackgroundColor="Beige"
                    WidthRequest="150"
                    HeightRequest="38"
                    FontSize="16">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>SAX API</x:String>
                        <x:String>DOM API</x:String>
                        <x:String>LINQ to XML</x:String>
                    </x:Array>
                </Picker.ItemsSource>

            </Picker>
            <Picker
                    x:Name="AttributePicker"
                    TextColor="Black"
                    BackgroundColor="Beige"
                    WidthRequest="150"
                    HeightRequest="40"
                    FontSize="16">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Факультет</x:String>
                        <x:String>Кафедра</x:String>
                        <x:String>Дисципліна</x:String>
                    </x:Array>
                </Picker.ItemsSource>

            </Picker>
            <Entry
                x:Name="EntryValue"
                Text=""
                TextColor="Black"
                FontSize="16"
                BackgroundColor="Beige"
                WidthRequest="150"
                HeightRequest="38"/>

            <Button
                x:Name="SearchButton"
                Text="Пошук"
                Clicked="SearchButton_Clicked"/>
            <Button
                x:Name="ClearButton"
                Text="Очистити"
                Clicked="ClearButton_Clicked"/>
        </HorizontalStackLayout>
        <Label Grid.Row="1" Grid.Column="0"
           x:Name="FileName"
           TextColor="Black"
           Text=""/>
        <ScrollView
        Orientation="Horizontal"
        Grid.Row="2"
        Grid.Column="0">
            <Editor
            x:Name="XMLEditor"
            BackgroundColor="Beige"
            FontFamily="Monaco"
            FontSize="15"
            TextColor="Black"
            IsSpellCheckEnabled="False"
            CharacterSpacing="1"
        ></Editor>
        </ScrollView>
        <HorizontalStackLayout
        Grid.Row="0"
        Grid.Column="1"
        Spacing="5"
        FlowDirection="RightToLeft">
            <Button
            x:Name="Exit"
            Text="Вийти"
            Clicked="ExitButton_Clicked"/>
            <Button
            x:Name="Info"
            Text="Довідка"
            Clicked="HelpButton_Clicked"/>
        </HorizontalStackLayout>
        <Label Grid.Row="1" Grid.Column="1"
        TextColor="Black"
        Text="Нещодавно відкриті"/>
        <ListView
        x:Name="RecentlyFiles"
        Grid.Row="2"
        Grid.Column="1"
        BackgroundColor="Beige"
        SeparatorColor="SandyBrown"
        ItemSelected="RecentlyFiles_Selected">
            <ListView.ItemsSource>
                <x:Array Type="{x:Type x:String}"/>
            </ListView.ItemsSource>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Padding="10">
                            <Label Text="{Binding}" TextColor="Black" FontSize="14"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</ContentPage>
